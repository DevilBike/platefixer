<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reads and writes the game's local character files (FFXIV_CHR folders), currently the
    portrait (Banner) section of UISAVE.DAT. No Dalamud or game dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
