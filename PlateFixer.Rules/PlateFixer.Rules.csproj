<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plate checking rules with no Dalamud or game dependency.
    The plugin fills a PlateSnapshot from game memory and runs PlateChecker on it.
    A standalone tool can load an exported snapshot (JSON) and run the same rules.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PlateFixer.Rules</RootNamespace>
  </PropertyGroup>
</Project>
